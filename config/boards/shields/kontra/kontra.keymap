#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEFAULT  0
#define NUM_MODS 1
#define BT_CTRL  2

/ {
	combos {
		compatible = "zmk,combos";

		Escape {
			bindings = <&kp ESCAPE>;
			key-positions = <1 2>;
		};

		Tab {
			bindings = <&kp TAB>;
			key-positions = <13 14>;
		};

		Left_Shift {
			bindings = <&kp LEFT_SHIFT>;
			key-positions = <25 26>;
		};

		Right_Shift {
			bindings = <&kp RIGHT_SHIFT>;
			key-positions = <33 34>;
		};

		Enter {
			bindings = <&kp ENTER>;
			key-positions = <21 22>;
		};

		Backspace {
			bindings = <&kp BACKSPACE>;
			key-positions = <9 10>;
		};
	};

	keymap {
		compatible = "zmk,keymap";

		default_layer {
			bindings = <
				&kp LA(NUMBER_1)  &kp Q     &kp W      &kp E         &kp R  &kp T      &kp Y      &kp U  &kp I          &kp O      &kp P     &kp LA(NUMBER_4)
				&kp LA(NUMBER_2)  &kp A     &kp S      &kp D         &kp F  &kp G      &kp H      &kp J  &kp K          &kp L      &kp SEMI  &kp LA(N5)
				&kp LA(NUMBER_3)  &kp Z     &kp X      &kp C         &kp V  &kp B      &kp N      &kp M  &kp COMMA      &kp DOT    &kp FSLH  &kp LA(NUMBER_6)
				&mo 4             &kp RWIN  &kp LCTRL  &kp LEFT_ALT  &mo 1  &kp SPACE  &kp SPACE  &mo 2  &kp RIGHT_ALT  &kp RCTRL  &none     &mo 4
				>;
		};

		layer_1 {
			bindings = <
				&none  &none   &none   &none  &none   &none  &none  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp MINUS     &kp PLUS
				&none  &none   &none   &none  &none   &none  &none  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp PERIOD    &kp MINUS
				&none  &trans  &trans  &none  &none   &none  &none  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0  &kp KP_MULTIPLY
				&none  &none   &none   &none  &trans  &none  &none  &mo 3         &none         &none         &kp EQUAL     &kp KP_DIVIDE
				>;
		};

		layer_2 {
			bindings = <
				&kp C_VOLUME_DOWN     &kp C_VOL_UP          &none  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &none  &none     &none           &none         &none      &none  &none
				&kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &none  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &none  &kp LEFT  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT  &none  &none
				&none                 &none                 &none  &kp LEFT_BRACE        &kp RIGHT_BRACE        &none  &none     &none           &none         &none      &none  &none
				&none                 &none                 &none  &none                 &none                  &none  &none     &none           &none         &none      &none  &none
				>;
		};

		layer_3 {
			bindings = <
				&kp F1        &kp F2        &kp F3        &kp F4        &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
				&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &none   &none   &none   &none   &none   &none    &none    &none
				&bt BT_CLR    &none         &none         &none         &none   &none   &none   &none   &none   &none    &none    &none
				&none         &none         &none         &none         &none   &none   &none   &none   &none   &none    &none    &bootloader
				>;
		};

		layer_4 {
			bindings = <
				&kp LC(LS(NUMBER_1))  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &kp LS(LC(NUMBER_4))
				&kp LS(LC(NUMBER_2))  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &kp LC(LS(N5))
				&kp LS(LC(NUMBER_3))  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &kp LC(LS(NUMBER_6))
				&none                 &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
				>;
		};
	};
};

